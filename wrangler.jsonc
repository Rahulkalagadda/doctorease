{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doctorease",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "dist/doctorease/index.js",
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "build": {
    "command": "mkdir -p dist/doctorease && touch dist/doctorease/index.js && export CLOUDFLARE=true && (bun run build || npm run build)"
  }
}