{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doctorease",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "dist/doctorease/index.js",
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "build": {
    "command": "mkdir -p dist/doctorease && touch dist/doctorease/index.js && (bun run build || npm run build)"
  }
}